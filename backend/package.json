{
  "name": "radar-concursos-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "reminders:dry-run": "ts-node src/notifications/run-reminders.ts --dry-run",
    "reminders:send": "ts-node src/notifications/run-reminders.ts",
    "catalog:admin": "ts-node src/competitions/infrastructure/catalog-admin-cli.ts",
    "catalog:intake": "ts-node src/competitions/infrastructure/run-source-intake.ts",
    "catalog:discover": "ts-node src/competitions/infrastructure/run-notice-discovery.ts",
    "edital:extract": "ts-node src/competitions/infrastructure/run-pdf-extraction.ts",
    "smoke:api": "node scripts/smoke-api.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "@types/pdf-parse": "^1.1.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
